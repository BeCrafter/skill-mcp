# ============================================================================
# Skill MCP Server - Environment Variables Configuration
# ============================================================================
#
# Copy this file to .env and adjust values for your environment
# Usage: cp .env.example .env
#
# For different deployment scenarios, see:
# - docs/DEVELOPMENT.md for detailed configuration guide
# - CLAUDE.md for scenario-specific environment examples
#

# ============================================================================
# Application Configuration
# ============================================================================

# Application environment
# Options: development, production, test
NODE_ENV=development

# API surface mode
# - MCP_ONLY=true: Expose only MCP endpoints + health endpoint (MCP edge proxy)
# - API_ONLY=true: Expose only REST API + health endpoint (storage backend)
# - Neither: Full mode, expose MCP + all REST endpoints (default)
# MCP_ONLY and API_ONLY are mutually exclusive.
MCP_ONLY_MODE=false
API_ONLY_MODE=false

# Log level for application output
# Options: trace, debug, info, warn, error
LOG_LEVEL=debug
# Note: Code default is 'info'; 'debug' is recommended for development.

# OpenTelemetry (optional)
# Set OTEL_ENABLED=true to enable tracing/metrics export.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=skill-mcp
OTEL_SERVICE_VERSION=

# JSON config file path (optional)
# When set, this file is deep-merged over env-based defaults.
# Required for aliyun-oss storage, embedding, and eval configuration.
SKILL_MCP_CONFIG=
# ============================================================================
# Storage Configuration
# ============================================================================

# Storage backend type
# Options: local-fs, aliyun-oss
STORAGE_TYPE=local-fs

# Local filesystem storage path (used when STORAGE_TYPE=local-fs)
# Skills will be stored at: {STORAGE_BASE_PATH}/skills/{slug}/
STORAGE_BASE_PATH=./data/skills
# Note: Code default is ~/.skill-mcp/data/skills

# Aliyun OSS storage can only be configured via SKILL_MCP_CONFIG JSON file.

# ============================================================================
# Database Configuration
# ============================================================================

DATABASE_PATH=./data/skill-mcp.db
# Note: Code default is ~/.skill-mcp/skill-mcp.db

# Alternative: Database URL (takes precedence over DATABASE_PATH)
# Supports: sqlite://... (default), postgres://... (future)
# DATABASE_URL=sqlite:./data/skill-mcp.db


# ============================================================================
# Transport Configuration
# ============================================================================

# Transport protocol for MCP server
# Options: stdio, sse, http
# - stdio: Standard I/O (local CLI, MCP clients)
# - sse: Server-Sent Events (HTTP streaming)
# - http: HTTP server with request/response
TRANSPORT_TYPE=stdio

# HTTP server port (only used when TRANSPORT_TYPE=http or sse)
TRANSPORT_PORT=3000

# ============================================================================
# Gateway Configuration (Remote Skill Proxy)
# ============================================================================
#
# Set CLOUD_SERVICE_URL to proxy skill requests to a remote service.
# When set, the server automatically uses RemoteSkillProvider (proxy mode).
# Admin API is disabled in proxy mode (admin ops belong on the data source).

# Base URL of remote cloud service
# Example: http://localhost:3001, https://skills-api.example.com
# CLOUD_SERVICE_URL=http://cloud-service:3001

#
# ## Token 统一：只需 `SKILL_MCP_AUTH_TOKEN`
#
# | 传输模式 | 入站 MCP 认证 | 出站远程代理认证 |
# |---|---|---|
# | stdio | `--auth-token` CLI flag 或 `SKILL_MCP_AUTH_TOKEN` env var | 同一个 token（双重用途） |
# | HTTP/SSE | 每个请求的 `Authorization: Bearer <token>` header | `SKILL_MCP_AUTH_TOKEN` env var |
#
# - 所有认证场景统一使用 `SKILL_MCP_AUTH_TOKEN`，不再需要单独的 `AUTH_TOKEN`。
# - stdio 模式下 `--auth-token` / `SKILL_MCP_AUTH_TOKEN` 承担双重角色：MCP 入站认证 + 远程代理出站认证。
# - HTTP/SSE 模式下，入站认证来自请求头 `Authorization: Bearer <token>`，出站代理认证使用 `SKILL_MCP_AUTH_TOKEN`。

# ============================================================================
# Cache Configuration
# ============================================================================

# Enable in-memory cache (L1 cache)
# Options: true, false
CACHE_MEMORY_ENABLED=true

# Maximum number of items in memory cache (LRU eviction)
CACHE_MEMORY_MAX_SIZE=500

# Enable file-based cache (L2 cache)
# Options: true, false
CACHE_FILE_ENABLED=true

CACHE_FILE_DIR=./data/cache
# Note: Code default is ~/.skill-mcp/cache

# TTL multiplier for L2 cache (file-based)
# File cache TTL = Memory cache TTL * this multiplier

# Embedding and eval configuration can only be set via SKILL_MCP_CONFIG JSON file.
#
# ============================================================================
# Security Configuration
# ============================================================================
# Enable prompt injection detection
# Scans skill instructions and responses for injection attacks
# Options: true, false
SECURITY_INJECTION_SCAN=true

# Emit Strict-Transport-Security on every HTTP response (T-737).
# Only enable when a TLS terminator (nginx / ALB / CDN) is in front of this
# process — sending HSTS from a plain-HTTP origin pins browsers to HTTPS for
# `max-age` seconds and breaks plain-HTTP access. Default: false.
# SECURITY_HSTS_ENABLED=false

# Access control:
# - API Key auth has been removed in favor of per-user RBAC.
# - Create users with: skill-mcp user create --name <name> --role-ids <id>
#   (see `skill-mcp role create --tags ...` for tag-based authorization).
# - HTTP/SSE callers send the printed token as `Authorization: Bearer <token>`.
# - For stdio mode, set SKILL_MCP_AUTH_TOKEN below to inject a bearer token at
#   process start (or pass `--auth-token <token>` to `skill-mcp serve`).
# - Skills default to visibility=private and are hidden from anonymous callers;
#   update visibility to "public" (Admin API or DB) to expose a skill.
# SKILL_MCP_AUTH_TOKEN=

# CLI remote mode (optional):
# - Set to connect CLI commands to a remote server instead of local DB
# - CLI login will use HTTP to authenticate against this server
# - When not set, CLI uses local DB + AUTH_JWT_SECRET for direct login
# SKILL_MCP_SERVER_URL=http://localhost:3000

# Admin API auth (legacy escape hatch):

# ============================================================================
# JWT Authentication Configuration
# ============================================================================

# JWT signing secret (minimum 32 characters, auto-generated on first init)
# AUTH_JWT_SECRET=your-secret-key-min-32-chars
#
# JWT access token TTL in seconds (default: 7200 = 2 hours)
# AUTH_JWT_ACCESS_EXPIRES_IN=7200
#
# JWT refresh token TTL in seconds (default: 604800 = 7 days)
# AUTH_JWT_REFRESH_EXPIRES_IN=604800
#
# JWT issuer claim (default: skill-mcp)
# AUTH_JWT_ISSUER=skill-mcp
#
# Allow anonymous access to /metrics endpoint (default: false)
# SKILL_MCP_METRICS_AUTH_OPTIONAL=false
#
# ============================================================================
# Rate Limiting Configuration
# ============================================================================
#
# Enable rate limiting (default: true)
# RATE_LIMIT_ENABLED=true
#
# Admin API rate limit (token bucket)
# RATE_LIMIT_ADMIN_CAPACITY=60
# RATE_LIMIT_ADMIN_REFILL_PER_SEC=10
#
# Gateway API rate limit (token bucket)
# RATE_LIMIT_GATEWAY_CAPACITY=120
# RATE_LIMIT_GATEWAY_REFILL_PER_SEC=20
# - /api/admin/* requires Bearer token whose role tags include `admin:write`.
#   Issue an admin token via:
#     skill-mcp role create --name admin --tags admin:write
#     skill-mcp user create --name <admin> --role-ids <admin-role-id>

# Scenario A: Local Development (stdio)
#   NODE_ENV=development
#   TRANSPORT_TYPE=stdio
#   STORAGE_BASE_PATH=./data/skills
#   DATABASE_PATH=./data/skill-mcp.db
#   LOG_LEVEL=debug
#
# Scenario B: Local proxy to remote service
#   [Local Client]
#   TRANSPORT_TYPE=stdio
#   CLOUD_SERVICE_URL=http://cloud-service:3001
#   SKILL_MCP_AUTH_TOKEN=your-token
#
#   [Remote Service]
#   TRANSPORT_TYPE=http
#   TRANSPORT_PORT=3001
#
# Scenario C1: Unified HTTP Server (all-in-one)
#   TRANSPORT_TYPE=http
#   TRANSPORT_PORT=3000
#   STORAGE_BASE_PATH=./data/skills
#   DATABASE_PATH=./data/skill-mcp.db
#
# Scenario C2: Distributed (MCP proxy → Storage backend)
#   [MCP Proxy]
#   TRANSPORT_TYPE=http
#   TRANSPORT_PORT=4000
#   CLOUD_SERVICE_URL=http://storage:3000
#   SKILL_MCP_AUTH_TOKEN=${STORAGE_SVC_TOKEN}
#   MCP_ONLY_MODE=true
#
#   [Storage Backend]
#   TRANSPORT_TYPE=http
#   TRANSPORT_PORT=3000
#   API_ONLY_MODE=true
#   STORAGE_TYPE=aliyun-oss
#
# ============================================================================
