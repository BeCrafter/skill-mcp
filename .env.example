# ============================================================================
# Skill MCP Server — Environment Variables  (v0.1 + C2)
# ============================================================================
# Copy to .env:   cp .env.example .env
# ============================================================================

# Application
NODE_ENV=development
LOG_LEVEL=debug

# API surface mode (mutually exclusive)
#   nothing set = full mode (MCP + all REST endpoints)
#   MCP_ONLY_MODE=true  = MCP endpoints + health only (edge proxy / C2 mcp node)
#   API_ONLY_MODE=true  = REST API + health only  (storage backend)
MCP_ONLY_MODE=false
API_ONLY_MODE=false

# ============================================================================
# Storage (v0.1: local-fs only)
# ============================================================================
STORAGE_TYPE=local-fs
STORAGE_BASE_PATH=./data/skills
# Code default: ~/.skill-mcp/data/skills

# ============================================================================
# Database (v0.1: SQLite only)
# ============================================================================
DATABASE_PATH=./data/skill-mcp.db
# Code default: ~/.skill-mcp/skill-mcp.db

# ============================================================================
# Transport
# ============================================================================
TRANSPORT_TYPE=stdio
TRANSPORT_PORT=3000

# ============================================================================
# C2 Remote-Proxy Mode (CLOUD_SERVICE_URL)
# ============================================================================
# Set CLOUD_SERVICE_URL to front a remote storage Registry via
# RemoteSkillProvider. The local process runs as an MCP-proxy (MCP_ONLY_MODE
# recommended); all skill reads + search are forwarded to the remote Registry.
# The remote Registry handles RBAC + BM25 via its own local SQLite index.
#CLOUD_SERVICE_URL=http://storage:3000

# Authentication token — dual role:
#   stdio mode:   serves as both inbound MCP auth and outbound remote-proxy auth
#   HTTP/SSE mode: inbound auth = request Authorization header; outbound = this token
#SKILL_MCP_AUTH_TOKEN=

# ============================================================================
# CLI remote mode (manage a remote Registry over HTTP)
# ============================================================================
# Set SKILL_MCP_SERVER_URL to point CLI commands (import, list, user, …) at a
# remote v0.1 Registry instead of the local DB.
#SKILL_MCP_SERVER_URL=http://localhost:3000

# ============================================================================
# Cache
# ============================================================================
CACHE_MEMORY_ENABLED=true
CACHE_MEMORY_MAX_SIZE=500
CACHE_FILE_ENABLED=true
CACHE_FILE_DIR=./data/cache

# ============================================================================
# Security
# ============================================================================
SECURITY_INJECTION_SCAN=true
#SECURITY_HSTS_ENABLED=false

# ============================================================================
# JWT Authentication (admin login)
# ============================================================================
#AUTH_JWT_SECRET=your-secret-min-32-chars
#AUTH_JWT_ACCESS_EXPIRES_IN=7200
#AUTH_JWT_REFRESH_EXPIRES_IN=604800
#AUTH_JWT_ISSUER=skill-mcp
#SKILL_MCP_METRICS_AUTH_OPTIONAL=false

# ============================================================================
# Rate Limiting
# ============================================================================
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_ADMIN_CAPACITY=60
#RATE_LIMIT_ADMIN_REFILL_PER_SEC=10
#RATE_LIMIT_GATEWAY_CAPACITY=120
#RATE_LIMIT_GATEWAY_REFILL_PER_SEC=20

# ============================================================================
# JSON config file (optional — deep-merged over env defaults)
# ============================================================================
#SKILL_MCP_CONFIG=

# ============================================================================
# Scenario quick-reference
# ============================================================================
#
# Scenario A — Local stdio development:
#   NODE_ENV=development  TRANSPORT_TYPE=stdio
#   STORAGE_BASE_PATH=./data/skills  DATABASE_PATH=./data/skill-mcp.db
#
# Scenario C1 — Single HTTP server (admin + gateway + MCP in one process):
#   TRANSPORT_TYPE=http  TRANSPORT_PORT=3000
#   STORAGE_BASE_PATH=./data/skills  DATABASE_PATH=./data/skill-mcp.db
#
# Scenario C2 — Distributed (storage backend + MCP proxy nodes):
#   [Storage Backend — holds the data]
#     TRANSPORT_TYPE=http  TRANSPORT_PORT=3000
#     API_ONLY_MODE=true
#     STORAGE_BASE_PATH=/app/data/skills  DATABASE_PATH=/app/data/skill-mcp.db
#     SKILL_MCP_AUTH_TOKEN=<token>
#
#   [MCP Proxy  — fronts the storage, MCP_ONLY]
#     TRANSPORT_TYPE=http  TRANSPORT_PORT=4000
#     MCP_ONLY_MODE=true
#     CLOUD_SERVICE_URL=http://storage:3000
#     SKILL_MCP_AUTH_TOKEN=<same-token-as-storage>
