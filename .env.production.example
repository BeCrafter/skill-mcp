# Production environment variables for docker-compose
# Copy this file to .env.production and fill in the values

# Storage API Key (required)
STORAGE_API_KEY=your-strong-api-key-here

# Log level (debug|info|warn|error)
LOG_LEVEL=info

# Storage Configuration
# Options: local-fs, aliyun-oss
STORAGE_TYPE=aliyun-oss

# Aliyun OSS Configuration (required when STORAGE_TYPE=aliyun-oss)
OSS_BUCKET=skill-mcp
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret