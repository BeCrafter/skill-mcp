# Scenario B: Local MCP Client
# stdio MCP + Remote Storage Server

NODE_ENV=development

# Transport: stdio (local process communication)
TRANSPORT_TYPE=stdio

# Deployment: gateway (use remote provider)
DEPLOYMENT_MODE=gateway

# Remote Storage Service
CLOUD_SERVICE_URL=http://localhost:3000
AUTH_TOKEN=test-key-1

# Storage: not used in gateway mode
STORAGE_TYPE=local-fs

# Database: can be empty in gateway mode or use local cache
DATABASE_PATH=./data/skill-mcp.db

# Cache: use local cache for RemoteProvider responses
CACHE_MEMORY_ENABLED=true
CACHE_MEMORY_MAX_SIZE=500
CACHE_FILE_ENABLED=true
CACHE_FILE_DIR=./data/cache

# Security
SECURITY_INJECTION_SCAN=true

# Stdio permission isolation: set SKILL_MCP_AUTH_TOKEN to a user token created
# via `skill-mcp user create ...` to enable per-user RBAC. Otherwise this client
# runs anonymously and only sees skills with visibility=public.
# SKILL_MCP_AUTH_TOKEN=

# MCP Mode
MCP_ONLY_MODE=false
