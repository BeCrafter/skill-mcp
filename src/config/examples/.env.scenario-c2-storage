# Scenario C2: Storage Service (Independent)
# HTTP Server providing only /api/gateway/* endpoints

NODE_ENV=production

# Transport: HTTP
TRANSPORT_TYPE=http
TRANSPORT_PORT=3000
TRANSPORT_HOST=0.0.0.0

# Deployment: standalone (use local data)
DEPLOYMENT_MODE=standalone

# Storage: local filesystem or cloud storage
STORAGE_TYPE=local-fs
STORAGE_BASE_PATH=./data/skills

# Database
DATABASE_PATH=./data/skill-mcp.db

# Cache
CACHE_MEMORY_ENABLED=true
CACHE_MEMORY_MAX_SIZE=500
CACHE_FILE_ENABLED=true
CACHE_FILE_DIR=./data/cache

# Security
SECURITY_INJECTION_SCAN=true

# Access control: API Key auth has been removed.
# To gate /api/gateway/* per caller, create users via:
#   skill-mcp role create --name <role> --tags "<tag1,tag2>"
#   skill-mcp user create --name <caller> --role-ids <role-id>
# Then have callers send the printed token as `Authorization: Bearer <token>`.
# Skills default to visibility=private and are hidden from anonymous callers;
# update a skill's visibility to "public" (via Admin API or DB) to expose it.

# MCP Mode: storage-only (only provide /api/gateway/*)
MCP_ONLY_MODE=true
