# Scenario B: Remote Storage Server
# HTTP Server providing /api/gateway/* endpoints

NODE_ENV=production

# Transport: HTTP
TRANSPORT_TYPE=http
TRANSPORT_PORT=3000
TRANSPORT_HOST=0.0.0.0

# Deployment: standalone (use local data)
DEPLOYMENT_MODE=standalone

# Storage: local filesystem
STORAGE_TYPE=local-fs
STORAGE_BASE_PATH=./data/skills

# Database
DATABASE_PATH=./data/skill-mcp.db

# Cache
CACHE_MEMORY_ENABLED=true
CACHE_MEMORY_MAX_SIZE=500
CACHE_FILE_ENABLED=true
CACHE_FILE_DIR=./data/cache

# Security
SECURITY_INJECTION_SCAN=true

# API Key Authentication (enabled for remote access)
ENABLE_API_KEY_AUTH=true
API_KEYS=test-key-1,test-key-2,prod-key-abcdef123456

# MCP Mode (normal mode, provide both MCP and /api/gateway)
MCP_ONLY_MODE=false
