# Scenario C2: MCP Service (Independent)
# HTTP Server providing only /mcp/* endpoints
# Connects to remote Storage Service for data

NODE_ENV=production

# Transport: HTTP
TRANSPORT_TYPE=http
TRANSPORT_PORT=4000

# Remote Storage Service (proxy auto-detected when CLOUD_SERVICE_URL is set)
CLOUD_SERVICE_URL=http://storage:3000
SKILL_MCP_AUTH_TOKEN=prod-storage-key-xyz123

# Storage: not used in proxy mode
STORAGE_TYPE=local-fs

# Database: local cache only
DATABASE_PATH=./data/skill-mcp.db

# Cache: use local cache for RemoteProvider responses
CACHE_MEMORY_ENABLED=true
CACHE_MEMORY_MAX_SIZE=500
CACHE_FILE_ENABLED=true
CACHE_FILE_DIR=./data/cache

# Security
SECURITY_INJECTION_SCAN=true

# Auth between MCP server and clients is handled via per-user bearer tokens in
# the Authorization header. Anonymous callers see only visibility=public skills.

# API Surface: MCP-only (only expose MCP + health endpoints)
MCP_ONLY_MODE=true
