# Scenario C1: Unified HTTP Deployment
# HTTP Server providing both /mcp/* and /api/gateway/* endpoints

NODE_ENV=production

# Transport: HTTP
TRANSPORT_TYPE=http
TRANSPORT_PORT=3000
TRANSPORT_HOST=0.0.0.0

# Deployment: standalone (use local data)
DEPLOYMENT_MODE=standalone

# Storage: local filesystem
STORAGE_TYPE=local-fs
STORAGE_BASE_PATH=./data/skills

# Database
DATABASE_PATH=./data/skill-mcp.db

# Cache
CACHE_MEMORY_ENABLED=true
CACHE_MEMORY_MAX_SIZE=500
CACHE_FILE_ENABLED=true
CACHE_FILE_DIR=./data/cache

# Security
SECURITY_INJECTION_SCAN=true

# API Key Authentication (optional)
ENABLE_API_KEY_AUTH=false

# MCP Mode: normal (provide both MCP and Admin API)
MCP_ONLY_MODE=false
