# Scenario C1: Unified HTTP Deployment
# HTTP Server providing both /mcp/* and /api/gateway/* endpoints

NODE_ENV=production

# Transport: HTTP
TRANSPORT_TYPE=http
TRANSPORT_PORT=3000

# Storage: local filesystem
STORAGE_TYPE=local-fs
STORAGE_BASE_PATH=./data/skills

# Database
DATABASE_PATH=./data/skill-mcp.db

# Cache
CACHE_MEMORY_ENABLED=true
CACHE_MEMORY_MAX_SIZE=500
CACHE_FILE_ENABLED=true
CACHE_FILE_DIR=./data/cache

# Security
SECURITY_INJECTION_SCAN=true

# Access control: API Key auth has been removed. /api/gateway/* requests are
# authenticated via per-user bearer tokens (see `skill-mcp user create`).
# Anonymous callers can only see skills with visibility=public.

# API Surface: default (MCP + Admin + Gateway)
MCP_ONLY_MODE=false
API_ONLY_MODE=false
