# Skill MCP Server - Caddy 反向代理配置
# 通过环境变量 MCP_BACKEND / STORAGE_BACKEND 指定后端地址：
#   C2+gateway:    docker compose --profile c2 --profile gateway up -d
#   C1+gateway:    docker compose --profile c1-gateway up -d
#
# DOMAIN 未设置或为 localhost 时走 HTTP（本地开发无证书问题）
# 设置真实域名（如 DOMAIN=example.com）时自动启用 HTTPS
#
# MCP_BACKEND 支持多个上游（空格分隔），Caddy 自动负载均衡：
#   MCP_BACKEND="mcp1:4000 mcp2:4000"
#
# ⚠ 启动前必须设置 MCP_BACKEND 和 STORAGE_BACKEND 环境变量，
#   不要依赖 Caddyfile 内的默认值。不同 profile 的后端地址不同。

{$DOMAIN:localhost} {
    # MCP 端点 — 负载均衡到多个上游
    handle /mcp* {
        reverse_proxy {$MCP_BACKEND:localhost:4000} {
            lb_try_duration 30s
            lb_try_interval 2s
        }
    }

    # Gateway API — 转发客户端认证 header
    handle /api/gateway/* {
        reverse_proxy {$STORAGE_BACKEND:localhost:3000} {
            header_up Authorization {>Authorization}
        }
    }

    # 健康检查 — 透传到 storage 后端
    handle /api/health {
        reverse_proxy {$STORAGE_BACKEND:localhost:3000}
    }

    # 安全头。HSTS 仅在 TLS 终止时由 Caddy 自动发送（HTTP 模式下忽略该指令）。
    # Caddy 内部也会自动添加 X-Content-Type-Options: nosniff。
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
    }

    # 日志
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}
